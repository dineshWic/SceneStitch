{
  "name": "@scenestitch/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./render": {
      "types": "./dist/services/render.d.ts",
      "import": "./dist/services/render.js"
    }
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@scenestitch/core": "workspace:*",
    "fastify": "^5.12.7",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/uuid": "^11.0.0"
  }
}
